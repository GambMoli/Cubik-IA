# Copy this file to .env and fill in the empty values:
#   cp .env.example .env
# .env is ignored by Git. Never commit real passwords.
# For LOCAL DEVELOPMENT ONLY.

# Docker Compose project name (prefix for containers and volumes).
COMPOSE_PROJECT_NAME=cubik-ia

# --- Web access ---------------------------------------------------------
# Host port for Moodle. Change it if 8085 is already in use.
MOODLE_HTTP_PORT=8085
# Host interface. 127.0.0.1 = only this machine can reach Moodle.
MOODLE_HTTP_BIND=127.0.0.1
# Public URL of the site. It MUST match the port above and the URL you type
# in the browser (Moodle redirects to this URL).
MOODLE_WWWROOT=http://localhost:8085

# --- Database (PostgreSQL 16) ------------------------------------------
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle
# Required. Generate one with: openssl rand -base64 24
MOODLE_DB_PASSWORD=
MOODLE_DB_PREFIX=mdl_

# --- Initial administrator (used only on the first install) -------------
MOODLE_ADMIN_USER=admin
# Required. Use at least 8 characters with upper case, lower case, a digit
# and a symbol (Moodle's default password policy).
MOODLE_ADMIN_PASSWORD=
# Required.
MOODLE_ADMIN_EMAIL=

# --- Site ----------------------------------------------------------------
MOODLE_SITE_FULLNAME="Cubik IA"
MOODLE_SITE_SHORTNAME=cubik
# Installation language. "en" is bundled; other languages can be added
# later from Site administration > Language > Language packs.
MOODLE_LANG=en

# Show PHP/Moodle debugging messages in the browser (true/false).
MOODLE_DEBUG=false

# --- Server only (docker-compose.prod.yml) -------------------------------
# Public domain pointing to the server. Without your own domain you can use
# sslip.io: for IP 129.146.10.20 use 129-146-10-20.sslip.io
# With docker-compose.prod.yml, MOODLE_WWWROOT becomes https://MOODLE_DOMAIN.
MOODLE_DOMAIN=
# Uncomment on the server so plain `docker compose` commands use both files:
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
